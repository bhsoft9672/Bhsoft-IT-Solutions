# Google Search Console Verification Token (Optional if verified via DNS or Google Analytics)
# If using HTML Tag method, copy the content value from <meta name="google-site-verification" content="XYZ" />
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools Verification Token (Optional if importing directly from Google Search Console)
# If using Meta tag method, copy the content value from <meta name="msvalidate.01" content="XYZ" />
NEXT_PUBLIC_BING_SITE_VERIFICATION=
